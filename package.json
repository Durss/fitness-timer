{
  "name": "fitness-timer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"npm run front/serve\" \"npm run server/watch\"",
    "build": "npm run front/build && npm run server/build",
    "front/serve": "vue-cli-service serve",
    "front/build": "vue-cli-service build",
    "server/watch": "tsc -w -p ./tsconfig_server.json",
    "server/build": "tsc -p ./tsconfig_server.json"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "express-serve-static-core": "^0.1.1",
    "gsap": "^3.15.0",
    "http": "0.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "concurrently": "^8.2.2",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "typescript": "~4.9.5",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
