{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"strictNullChecks": false,
		"sourceMap": false,
		"rootDir": "./src_server",
		"outDir": "./server",
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"lib": [
			"es2022"
		]
	},
	"include": [
		"src_server/**/*.ts",
		"src_server/**/*.tsx"
	],
	"exclude": [
		"node_modules"
	]
}
